# Copie para .env.local e preencha (não commite segredos).

# Painel admin (/admin): e-mails separados por vírgula (mesmo login Supabase)
ADMIN_EMAILS=seu@email.com

# Supabase — expostos ao browser (Next.js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Login Google (OAuth): no Dashboard → Authentication → URL Configuration, inclua em Redirect URLs:
#   http://localhost:3000/auth/callback
#   https://<seu-dominio>/auth/callback
# Ative o provider Google em Authentication → Providers e use o Client ID/Secret do Google Cloud Console.

# Supabase — apenas servidor (rotas /api, webhooks). Obtenha em Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# URL pública da app (redirects do Stripe Checkout e Customer Portal)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — apenas servidor
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhooks: crie um endpoint apontando para POST /api/stripe/webhook e use o signing secret
STRIPE_WEBHOOK_SECRET=

# IDs do PREÇO (price_...), não do produto (prod_...). Stripe → Produto → Preços → ⋮ → Copiar ID do preço
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PRO=

# Evolution API — aviso ao ganhador da raspadinha (somente servidor; não use NEXT_PUBLIC_*)
# Suba a API com Docker: https://github.com/EvolutionAPI/evolution-api — pareie a instância (QR) e use a URL pública.
# Documentação v2: https://doc.evolution-api.com/v2/api-reference/message-controller/send-text
EVOLUTION_API_BASE_URL=https://sua-evolution.exemplo.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
